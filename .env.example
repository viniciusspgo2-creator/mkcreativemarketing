# ── Banco PostgreSQL (Neon) — OBRIGATÓRIO na Vercel ──
# Formato: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# No Neon: Dashboard → Connection Details → copie a "Connection string".
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Primeiro acesso, apenas se o banco ainda não tiver usuários.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
# Senha exclusiva de pelo menos 16 caracteres. Remova as duas variáveis após criar o administrador.
ANALYTICS_SALT=""

# ── Opcionais para o build na Vercel ──
# DIRECT_URL = connection string DIRETA do Neon (sem -pooler), usada só no prisma db push
# PRISMA_ACCEPT_DATA_LOSS=1 = só se precisar de mudança destrutiva no schema
